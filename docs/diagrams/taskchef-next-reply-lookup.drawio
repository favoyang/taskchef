<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron">
  <diagram id="main" name="Current reply lookup">
    <mxGraphModel page="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Example: find the current reply after reverting a chat&lt;/b&gt;" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;fillColor=none;strokeColor=none;fontSize=23;spacing=0;">
          <mxGeometry as="geometry" x="40" y="20" width="1100" height="50" />
        </mxCell>
        <mxCell id="chat" value="&lt;b&gt;1. Chat C&lt;/b&gt;&lt;hr&gt;state_5.sqlite&lt;br&gt;threads.id = C&lt;br&gt;&lt;br&gt;rollout_path names&lt;br&gt;…-C_R.jsonl" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;fillColor=#edf4ff;">
          <mxGeometry as="geometry" x="40" y="110" width="235" height="205" />
        </mxCell>
        <mxCell id="rollout" value="&lt;b&gt;2. Rollout R&lt;/b&gt;&lt;hr&gt;Take R from the&lt;br&gt;selected filename.&lt;br&gt;&lt;br&gt;This is a lookup step,&lt;br&gt;not a database table." vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;fillColor=#fff8df;">
          <mxGeometry as="geometry" x="340" y="110" width="235" height="205" />
        </mxCell>
        <mxCell id="turn" value="&lt;b&gt;3. Latest turn T&lt;/b&gt;&lt;hr&gt;thread_turns&lt;br&gt;thread_id = R&lt;br&gt;&lt;br&gt;Latest rollout_ordinal&lt;br&gt;gives turn_id = T." vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;fillColor=#edf9f4;">
          <mxGeometry as="geometry" x="640" y="110" width="235" height="205" />
        </mxCell>
        <mxCell id="reply" value="&lt;b&gt;4. Saved reply I&lt;/b&gt;&lt;hr&gt;thread_items&lt;br&gt;thread_id = R&lt;br&gt;turn_id = T&lt;br&gt;item_id = final_agent_item_id&lt;br&gt;&lt;br&gt;Read item_json.text." vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;fillColor=#edf9f4;">
          <mxGeometry as="geometry" x="940" y="110" width="255" height="205" />
        </mxCell>
        <mxCell id="edge0" parent="1" source="chat" target="rollout" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=2;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge1" parent="1" source="rollout" target="turn" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=2;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" parent="1" source="turn" target="reply" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=2;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;The chat ID stays C. The selected history may change to R.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ordinary filename: …-C.jsonl → history lookup uses C.&lt;br&gt;After revert: …-C_R.jsonl → history lookup uses R. Old rows under C may remain.&lt;br&gt;Real IDs are UUIDs; compressed .jsonl.zst files use the same rule.&lt;br&gt;If no final reply is linked yet, TaskChef reads the latest saved agent message in turn T.&lt;br&gt;These arrows show lookup steps, not SQL foreign-key constraints." vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;fillColor=#f7f9fc;">
          <mxGeometry as="geometry" x="40" y="365" width="1155" height="205" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>