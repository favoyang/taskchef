<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron">
  <diagram id="main" name="Files and tables">
    <mxGraphModel page="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Codex storage: which table belongs where&lt;/b&gt;" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;fillColor=none;strokeColor=none;fontSize=24;spacing=0;">
          <mxGeometry as="geometry" x="40" y="20" width="1030" height="45" />
