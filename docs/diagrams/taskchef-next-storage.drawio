        </mxCell>
        <mxCell id="threads" value="&lt;b&gt;threads&lt;/b&gt;&lt;hr&gt;id: stable chat ID&lt;br&gt;name / title, project folder, archived&lt;br&gt;rollout_path: selected history file&lt;br&gt;model, tokens, timestamps" vertex="1" parent="state" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;">
          <mxGeometry as="geometry" x="20" y="65" width="430" height="170" />
        </mxCell>
        <mxCell id="children" value="&lt;b&gt;thread_spawn_edges&lt;/b&gt;&lt;hr&gt;parent_thread_id → child_thread_id&lt;br&gt;Chat IDs; used to hide subagents&lt;br&gt;and count direct children" vertex="1" parent="state" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;">
          <mxGeometry as="geometry" x="20" y="265" width="430" height="140" />
        </mxCell>
        <mxCell id="history" value="&lt;b&gt;thread_history_1.sqlite — turns and messages&lt;/b&gt;" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;swimlane;container=1;startSize=48;fillColor=#edf9f4;swimlaneFillColor=#edf9f4;">
