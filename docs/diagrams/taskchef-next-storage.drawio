        </mxCell>
        <mxCell id="turns" value="&lt;b&gt;thread_turns&lt;/b&gt;&lt;hr&gt;thread_id: selected rollout ID&lt;br&gt;turn_id, status, start / end time&lt;br&gt;first_user_item_id, final_agent_item_id" vertex="1" parent="history" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;">
          <mxGeometry as="geometry" x="20" y="60" width="480" height="140" />
        </mxCell>
        <mxCell id="items" value="&lt;b&gt;thread_items&lt;/b&gt;&lt;hr&gt;thread_id + turn_id + item_id&lt;br&gt;item_type, item_json: saved message or tool data" vertex="1" parent="history" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;">
          <mxGeometry as="geometry" x="20" y="225" width="480" height="120" />
        </mxCell>
        <mxCell id="projection" value="&lt;b&gt;thread_history_projection_state&lt;/b&gt;&lt;hr&gt;Rollout ID, next byte offset and ordinal&lt;br&gt;Tracks history import; not queried by the board" vertex="1" parent="history" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;">
          <mxGeometry as="geometry" x="20" y="365" width="480" height="110" />
        </mxCell>
        <mxCell id="jsonl" value="&lt;b&gt;Selected rollout .jsonl / .jsonl.zst file&lt;/b&gt;&lt;hr&gt;Ordered records: type, timestamp, payload&lt;br&gt;Examples: session_meta, event_msg, response_item&lt;br&gt;Saved history used to build the history database.&lt;br&gt;TaskChef reads logs only for optional selected-chat details." vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontSize=16;fontColor=#172b4d;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9caec2;fillColor=#f4effa;">
          <mxGeometry as="geometry" x="40" y="620" width="680" height="155" />
