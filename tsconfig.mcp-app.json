{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "src/mcp-app/react/**/*.ts",
    "src/mcp-app/react/**/*.tsx",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "vite.mcp-app.config.ts",
    "vitest.config.ts"
  ]
}
