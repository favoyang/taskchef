{
  "extends": "../tsconfig.mcp-app.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": "..",
    "paths": {
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom": [
        "node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../src/ui/**/*",
    "../src/mcp-app/react/NextTaskDetail.tsx",
    "../src/mcp-app/react/ProjectPicker.tsx",
    "../src/mcp-app/react/themes.ts"
  ]
}
